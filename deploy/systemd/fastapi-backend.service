[Unit]
Description=GetAiPilot Voice Pilot FastAPI & AudioSocket Backend Service
After=network.target asterisk.service
Wants=asterisk.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/asterisk/backend
EnvironmentFile=/root/asterisk/backend/.env
ExecStart=/root/asterisk/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8010 --workers 1
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice-pilot-backend

[Install]
WantedBy=multi-user.target
